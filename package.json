{
  "name": "wuwa-dps-calculator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run ui-data:generate && next dev",
    "build": "npm run ui-data:generate && next build",
    "build:cloudflare": "npm run ui-data:generate && opennextjs-cloudflare build",
    "start": "next start",
    "preview": "npm run ui-data:generate && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run ui-data:generate && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run ui-data:generate && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "assets:sync": "node scripts/run-safe-wuwa-assets.mjs",
    "assets:sync:dry": "node scripts/run-safe-wuwa-assets.mjs --dry-run",
    "assets:verify": "node scripts/verify-wuwa-assets.mjs",
    "assets:ui-projection": "node scripts/generate-wuwa-ui-asset-projection-v1.mjs",
    "assets:test-security": "node scripts/test-wuwa-assets-security.mjs",
    "assets:test-verifier": "node scripts/test-wuwa-asset-verifier.mjs",
    "assets:test-ui-projection-security": "node scripts/test-wuwa-ui-asset-projection-security.mjs",
    "game-data:import": "node scripts/import-wuwa-game-data.mjs",
    "game-data:import:audit": "node scripts/import-wuwa-game-data.mjs --audit-only",
    "game-data:test-security": "node scripts/test-wuwa-game-data-import-security.mjs",
    "game-data:normalize": "node scripts/normalize-wuwa-game-data.mjs && node scripts/harden-wuwa-normalized-source.mjs && node scripts/classify-wuwa-echo-catalog.mjs",
    "game-data:test-normalizer-security": "node scripts/test-wuwa-game-data-normalizer-security.mjs",
    "game-data:test-hardening-security": "node scripts/test-wuwa-normalized-source-hardening-security.mjs && node scripts/test-wuwa-echo-catalog-classifier-security.mjs",
    "game-data:readiness": "node scripts/analyze-wuwa-game-data-readiness.mjs",
    "game-data:test-readiness-security": "node scripts/test-wuwa-game-data-readiness-security.mjs && node scripts/test-wuwa-game-database-generator-security.mjs && node scripts/test-wuwa-stat-progression-security.mjs",
    "game-data:generate": "node scripts/generate-wuwa-game-database-v1.mjs",
    "game-data:build": "npm run game-data:normalize && npm run game-data:readiness && npm run game-data:generate",
    "game-data:echo-catalog": "node scripts/generate-wuwa-echo-catalog-v1.mjs",
    "game-data:test-echo-catalog-security": "node scripts/test-wuwa-echo-catalog-security.mjs",
    "game-data:test-promotion-security": "node scripts/test-generated-game-database-promotion-security.mjs",
    "character-box:roster-10r1": "node scripts/generate-character-box-roster-10r1.mjs",
    "character-box:roster-baselines-10r1": "node scripts/generate-character-box-roster-baselines-10r1.mjs",
    "character-box:combat-10r1": "node scripts/generate-character-box-combat-10r1.mjs",
    "character-box:reviewed-combat": "node scripts/generate-reviewed-character-game-database-combat.mjs",
    "character-box:future-dps-prep": "node scripts/generate-character-box-future-dps-prep.mjs",
    "character-box:precise-dps-future": "node scripts/generate-precise-dps-future-projection.mjs",
    "character-box:precise-baselines": "node scripts/generate-precise-character-box-baselines.mjs",
    "character-box:precise-echo-presets": "node scripts/generate-precise-character-box-echo-presets.mjs",
    "character-box:roster-media-10r1": "node scripts/generate-character-box-roster-media-10r1.mjs",
    "character-box:community-echo-presets": "node scripts/generate-character-box-community-echo-presets.mjs",
    "ui-data:generate": "npm run game-data:echo-catalog && npm run assets:ui-projection && npm run character-box:roster-10r1 && npm run character-box:roster-baselines-10r1 && npm run character-box:combat-10r1 && npm run character-box:reviewed-combat && npm run character-box:future-dps-prep && npm run character-box:precise-dps-future && npm run character-box:precise-baselines && npm run character-box:precise-echo-presets && npm run character-box:roster-media-10r1 && npm run character-box:community-echo-presets",
    "lint": "npm run ui-data:generate && eslint",
    "typecheck": "npm run ui-data:generate && next typegen && tsc --noEmit",
    "test": "npm run ui-data:generate && npm run game-data:test-echo-catalog-security && npm run assets:test-ui-projection-security && vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.25.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}