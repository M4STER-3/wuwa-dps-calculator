/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# temporary/quarantine import data
/.tmp/

# build-generated browser projections
/public/data/wuwa/echo-catalog-v1.json
/public/data/wuwa/ui-asset-projection-v1.json
/src/generated/character-box-roster-10r1.ts
/src/generated/character-box-roster-media-10r1.ts
/src/generated/character-box-roster-baselines-10r1.ts

